<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SharkConfig</AssemblyName>
    <RootNamespace>SharkConfig</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.4.0</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- consumo: GC de estação sem thread em segundo plano, sem dados ICU, só recursos pt/en -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>pt-BR;en</SatelliteResourceLanguages>
    <NoWarn>MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- ícone da janela e da barra de tarefas (o mesmo do .exe) -->
    <EmbeddedResource Include="app.ico" LogicalName="SharkConfig.app.ico" />
  </ItemGroup>
</Project>
